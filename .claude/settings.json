{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    {
                        "type": "command",
                        "command": "cd \"$(git rev-parse --show-toplevel)\" && terraform fmt -check -diff . 2>&1 || true"
                    },
                    {
                        "type": "command",
                        "command": "cd \"$(git rev-parse --show-toplevel)\" && terraform validate 2>&1 || true"
                    },
                    {
                        "type": "command",
                        "command": "cd \"$(git rev-parse --show-toplevel)\" && tflint --no-color 2>&1 || true"
                    }
                ]
            }
        ]
    }
}
